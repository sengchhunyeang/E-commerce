# Neon connection string — use the pooled (-pooler) host for Vercel
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs login cookies. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Telegram bot (from @BotFather). Send /myid to the bot to find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Any random string; Telegram sends it back so the webhook can reject fakes
TELEGRAM_WEBHOOK_SECRET=

# Class reminder (settings are on the /admin page)
# Any random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Neon Object Storage for product images (Neon console → Connect → Storage)
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-1.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=e-commerce

# Password reset emails (optional) — API key from resend.com and a sender on your verified domain.
# Without them, reset links are only sent to customers who connected Telegram.
RESEND_API_KEY=
MAIL_FROM=WebShop <shop@yourdomain.com>
