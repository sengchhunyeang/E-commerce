# Neon connection string — use the pooled (-pooler) host for Vercel
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Telegram bot (from @BotFather). Send /myid to the bot to find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Any random string; Telegram sends it back so the webhook can reject fakes
TELEGRAM_WEBHOOK_SECRET=

# Daily class reminder, sent by Vercel Cron (schedule in vercel.json)
CLASS_REMINDER_CHAT_ID=
# Any random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
